pipeline{
    agent any
    
    tools {
        maven "maven"
    }

    stages{
        stage('Git checkout'){
            steps{
            git branch: 'ci-jenkins', credentialsId: 'Githubkey', url: 'git@github.com:Ranjith-kumar533/vprofile-project-hkh.git'
            }
        }

        stage('Unit test'){
            steps{
                sh 'mvn test'
            }
        }

         stage('Integration test'){
            steps{
                sh 'mvn verify -DskipUnitTests'
            }
        }

        stage('Build'){
            steps{
                sh 'mvn clean install -DskipTests'
            }
            post {
                success {
                    echo 'Now Archiving...'
                    archiveArtifacts artifacts: '**/target/*.war'
                }
            }
        }
    }
}